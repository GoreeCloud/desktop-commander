{
  "name": "@goreecloud/desktop-commander",
  "version": "0.1.0",
  "description": "GoreeCloud Desktop Commander — local MCP file and terminal tools (development import)",
  "mcpName": "app.goreecloud/desktop-commander",
  "license": "MIT",
  "author": "Eduard Ruzga and Desktop Commander contributors (MIT upstream); GoreeCloud derivative maintainers",
  "homepage": "https://github.com/GoreeCloud/desktop-commander",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoreeCloud/desktop-commander.git"
  },
  "bugs": "https://github.com/GoreeCloud/desktop-commander/issues",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "goreecloud-desktop-commander": "dist/index.js"
  },
  "files": [
    "dist",
    "logo.png",
    "testemonials"
  ],
  "scripts": {
    "build": "tsc && shx mkdir -p dist/data && shx cp src/data/onboarding-prompts.json dist/data/ && shx mkdir -p dist/remote-device/scripts && shx cp src/remote-device/scripts/blocking-offline-update.js dist/remote-device/scripts/ && node scripts/build-ui-runtime.cjs",
    "test": "npm run test:goreecloud && npm run build",
    "test:ci": "npm test",
    "test:goreecloud": "node --test test/goreecloud-hardening.test.mjs",
    "validate:tools": "npm run build && node scripts/validate-tools-sync.js",
    "test:upstream": "npm run build && node test/run-ci.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "terminal",
    "claude",
    "ai",
    "command-line",
    "process-management",
    "file-editing",
    "code-editing",
    "diff",
    "patch",
    "block-editing",
    "file-system",
    "text-manipulation",
    "code-modification",
    "surgical-edits",
    "file-operations"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opendocsg/pdf2md": "0.3.4",
    "@supabase/supabase-js": "^2.89.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vscode/ripgrep": "^1.15.9",
    "cross-fetch": "^4.1.0",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "glob": "^10.3.10",
    "highlight.js": "^11.11.1",
    "isbinaryfile": "^5.0.4",
    "markdown-it": "^14.1.0",
    "md-to-pdf": "^5.2.5",
    "mqtt": "5.16.0",
    "node-forge": "1.4.3",
    "open": "^10.2.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "proper-lockfile": "^4.1.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "tiptap-markdown": "^0.9.0",
    "unbash": "6.0.1",
    "unified": "^11.0.5",
    "unpdf": "~1.8.1",
    "zod": "^4.6.6",
    "zod-to-json-schema": "^3.23.5"
  },
  "optionalDependencies": {
    "caffeinate": "^1.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.2.0",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@types/node": "^20.17.24",
    "@types/node-forge": "1.3.14",
    "@types/proper-lockfile": "^4.1.4",
    "aedes": "0.51.3",
    "c8": "^12.0.0",
    "commander": "^13.1.0",
    "esbuild": "^0.27.2",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^24.1.3",
    "nexe": "^5.0.0-beta.4",
    "nodemon": "^3.0.2",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "ws": "^8.18.3"
  },
  "overrides": {
    "md-to-pdf": {
      "chokidar": "^4.0.3"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "proxy-addr": "^2.0.8",
    "argparse": "^2.0.1"
  }
}
